# Copy to .env — never commit .env
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
PRODUCT_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USER=nexus
RABBITMQ_PASSWORD=change-me
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@nexus.local
ADMIN_PASSWORD=change-me-strong-admin-password
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
GATEWAY_PORT=3000
FRONTEND_PORT=5173
INTERNAL_TOKEN=change-me-internal-service-token
# Google login (free): create an OAuth Web client at console.cloud.google.com, put its ID here and in frontend build env
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Email verification / password reset: leave MAIL_HOST empty for dev (links are logged), or set SMTP (Gmail app password / Brevo)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
APP_BASE_URL=http://localhost:5173
